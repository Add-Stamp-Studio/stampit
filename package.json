{
  "name": "add-stamp",
  "version": "2.2.0",
  "description": "A Nuxt 4 application for applying watermarks to images using WebAssembly (WASM) for high-performance image processing",
  "keywords": [
    "nuxt4",
    "vue3",
    "typescript",
    "tailwindcss",
    "webassembly",
    "wasm",
    "rust",
    "image-processing",
    "watermark",
    "stamp",
    "batch-processing",
    "cloudflare-workers",
    "browser",
    "images",
    "image-processing",
    "batch-processing",
    "wrangler"
  ],
  "homepage": "https://github.com/Add-Stamp-Studio/stampit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Add-Stamp-Studio/stampit.git"
  },
  "bugs": {
    "url": "https://github.com/Add-Stamp-Studio/stampit/issues"
  },
  "author": {
    "name": "howbizarre",
    "url": "https://github.com/howbizarre"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:icons": "node scripts/build-icons.mjs",
    "dev": "nuxt dev --port 5654",
    "test": "cd wasm && cargo test",
    "bench:wasm": "cd wasm && cargo run --release --example bench",
    "generate": "nuxt generate",
    "preview": "npm run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:package": "npm --prefix packages/image-stamper run build",
    "test:package": "npm --prefix packages/image-stamper test"
  },
  "dependencies": {
    "@howbizarre/image-stamper": "^0.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "jszip": "^3.10.2",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "nitro-cloudflare-dev": "^0.2.2",
    "nitropack": "^2.13.6",
    "sharp": "^0.35.5",
    "wrangler": "^4.160.1"
  }
}
